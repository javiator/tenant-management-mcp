BACKEND_MCP_BASE_URL=http://localhost:8080
# BACKEND_MCP_API_TOKEN=your_backend_token_here

# MCP Server Authentication (comma-separated bearer tokens)
# Clients authenticate via Authorization: Bearer <token> header
# Leave empty to disable authentication (development mode)
# MCP_API_KEYS=mcp_key1,mcp_key2,mcp_key3

# MCP Remote Client Configuration (for run-mcp-remote.sh)
# Transport to use (sse or streamablehttp)
MCP_REMOTE_TRANSPORT=streamablehttp
# Connection timeout in seconds (useful for cold starts)
HTTPX_TIMEOUT=60

