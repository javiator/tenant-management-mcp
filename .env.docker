# Docker Compose environment configuration
# Copy this file to .env.local and customize for your environment

# Backend API Configuration
BACKEND_MCP_BASE_URL=http://host.docker.internal:8080
# BACKEND_MCP_API_TOKEN=your_backend_token_here

# MCP Server Authentication
# Generate keys with: uv run python scripts/manage_keys.py generate --name "Dev User"
# Export keys with: uv run python scripts/manage_keys.py export
# Leave empty to disable authentication (development mode)
MCP_API_KEYS=

# Example with keys (uncomment and replace with real keys):
# MCP_API_KEYS=mcp_key1,mcp_key2,mcp_key3
